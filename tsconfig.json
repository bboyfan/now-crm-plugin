{
	"compilerOptions": {
		"target": "ES2020",
		"lib": [ "DOM", "ES2020" ],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true
	},
	"include": [ "src/**/*.ts", "src/**/*.tsx" ],
	"exclude": [ "src/**/*.test.ts" ]
}
